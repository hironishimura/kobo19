# Xserver へテーマを反映するための設定。
# このファイルを .deploy.env という名前で写して、値を埋めてください。
# .deploy.env は Git に入りません。

# サーバーID（サーバーパネル右上に出ている英数字。SSH のユーザー名でもある）
XSERVER_ID=xs123456

# ホスト名（サーバーパネル → サーバー情報 の「ホスト名」）
XSERVER_HOST=sv12345.xserver.jp

# SSH の秘密鍵（サーバーパネル → SSH設定 で生成してダウンロードしたもの）
XSERVER_KEY=~/.ssh/xserver_qkobo.key

# 反映先のドメイン
XSERVER_DOMAIN=qkobo.jp
